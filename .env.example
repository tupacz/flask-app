# Telegram Mini App Environment Variables
# Copy this to .env and fill in your actual values

# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your deployed app URL (must be HTTPS)
WEB_APP_URL=https://your-domain.com/telegram

# Secret key for Flask sessions (generate a random string)
SECRET_KEY=your-secret-key-here

# Optional: Set to False for production
DEBUG=True
